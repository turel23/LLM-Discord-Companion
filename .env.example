# .env.example

# The Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# The Discord Guild (Server) ID to use for slash/app commands (numbers only)
GUILD_ID=your-discord-server-id-here

# The system prompt for the LLM bot's personality and behavior
PROMPT=your-custom-system-message-here

# Add any extra config variables your LLM might need below
